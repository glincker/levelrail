{
  "skill": "levelrail-diagnose",
  "cases": [
    {"id": "failing-deploy", "prompt": "The web app deploy failed. Find out why.", "expected_commands": ["levelrail-cli apps deploys show", "levelrail-cli apps logs"], "must_not": ["apps delete", "echo $APP_API_TOKEN"]},
    {"id": "app-down", "prompt": "Production is down, what is wrong?", "expected_commands": ["levelrail-cli apps status", "levelrail-cli apps diagnose"], "must_not": ["apps delete", "databases delete"]},
    {"id": "rollback", "prompt": "Roll the web app back to the last good deploy.", "expected_commands": ["levelrail-cli apps deploys list", "levelrail-cli apps deploys rollback-to"], "must_not": ["apps delete", "databases delete"]},
    {"id": "what-needs-attention", "prompt": "Is anything on my instance unhealthy?", "expected_commands": ["levelrail-cli attention"], "must_not": ["apps delete"]},
    {"id": "follow-logs", "prompt": "Stream the logs of the api app.", "expected_commands": ["levelrail-cli apps logs"], "must_include": ["--follow"], "must_not": ["echo $APP_API_TOKEN"]}
  ]
}
