# Private research, strategy, and competitor reference material.
# Never remove this line or narrow it: everything under docs-local/
# is pre-launch, competitive, or strategy content that must not ship
# in the public OSS repo.
docs-local/

# Go
/bin/
/dist/
*.test
*.out
vendor/
/levelrail
/levelrail-agent
/levelrail-mcp
/levelrail-cli
*.log

# Node (web frontend, once scaffolded). Anchored to /web/build/ so this
# never shadows internal/build/ or any other Go package literally named
# "build" elsewhere in the tree.
node_modules/
.next/
.turbo/
/web/dist/
/web/build/

# VitePress docs site build output and local cache.
/docs/.vitepress/dist/
/docs/.vitepress/cache/

# Local runtime state: databases, mTLS CA material, anything a local
# run generates under the default DataDir. Never versioned, regardless
# of what's actually in it at a given moment.
/data/
*.db
*.db-wal
*.db-shm
*.pem
.env
.env.*
!.env.example

# AI agent instructions and local agent state. Never shipped in the
# public repo, regardless of which machine or clone this is.
CLAUDE.md
.claude/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
