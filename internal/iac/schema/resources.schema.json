{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glinr.com/levelrail/schema/resources.json",
  "title": "Platform resource document",
  "description": "One document of a multi-document resource file read by apply. The $defs of the app.yaml schema are merged in unchanged, so a service under App.spec.service follows exactly the app.yaml service rules.",
  "type": "object",
  "required": ["version", "kind", "metadata"],
  "properties": {
    "version": { "const": 1 },
    "kind": { "enum": ["Project", "Environment", "Tag", "Database", "App", "Domain", "LoadBalancer", "Pipeline", "AlertRule"] },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "type": "object" }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "kind": { "const": "Project" } }, "required": ["kind"] }, "then": { "properties": { "spec": { "$ref": "#/$defs/projectSpec" } } } },
    { "if": { "properties": { "kind": { "const": "Environment" } }, "required": ["kind"] }, "then": { "required": ["spec"], "properties": { "spec": { "$ref": "#/$defs/environmentSpec" } } } },
    { "if": { "properties": { "kind": { "const": "Tag" } }, "required": ["kind"] }, "then": { "properties": { "spec": { "type": "object", "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "Database" } }, "required": ["kind"] }, "then": { "required": ["spec"], "properties": { "spec": { "$ref": "#/$defs/databaseSpec" } } } },
    { "if": { "properties": { "kind": { "const": "App" } }, "required": ["kind"] }, "then": { "required": ["spec"], "properties": { "spec": { "$ref": "#/$defs/appSpec" } } } },
    { "if": { "properties": { "kind": { "const": "Domain" } }, "required": ["kind"] }, "then": { "required": ["spec"], "properties": { "spec": { "$ref": "#/$defs/domainSpec" } } } },
    { "if": { "properties": { "kind": { "const": "LoadBalancer" } }, "required": ["kind"] }, "then": { "required": ["spec"], "properties": { "spec": { "$ref": "#/$defs/loadbalancer" } } } },
    { "if": { "properties": { "kind": { "const": "Pipeline" } }, "required": ["kind"] }, "then": { "required": ["spec"], "properties": { "spec": { "$ref": "#/$defs/pipelineSpec" } } } },
    { "if": { "properties": { "kind": { "const": "AlertRule" } }, "required": ["kind"] }, "then": { "required": ["spec"], "properties": { "spec": { "$ref": "#/$defs/alertRuleSpec" } } } }
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "description": "Resource name, unique within its kind.", "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "labels": { "description": "Free-form labels.", "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "literalEnv": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "projectSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "env": { "description": "Environment variables shared by the project.", "$ref": "#/$defs/literalEnv" } }
    },
    "environmentSpec": {
      "type": "object",
      "required": ["project"],
      "additionalProperties": false,
      "properties": {
        "project": { "description": "Name of the project the environment belongs to.", "type": "string", "minLength": 1 },
        "protected": { "description": "Mark the environment as protected.", "type": "boolean" },
        "env": { "description": "Environment variables for this environment.", "$ref": "#/$defs/literalEnv" }
      }
    },
    "databaseSpec": {
      "type": "object",
      "required": ["engine"],
      "additionalProperties": false,
      "properties": {
        "engine": { "description": "Database engine.", "$ref": "#/$defs/database/properties/engine" },
        "version": { "description": "Engine version.", "type": "string", "minLength": 1 },
        "project": { "description": "Name of the project the database belongs to.", "type": "string", "minLength": 1 },
        "pooler": {
          "description": "Connection pooler in front of the database.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "pool_size": { "type": "integer", "minimum": 1 },
            "max_client_conn": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "appSpec": {
      "type": "object",
      "required": ["service"],
      "additionalProperties": false,
      "properties": {
        "project": { "description": "Name of the project the app belongs to.", "type": "string", "minLength": 1 },
        "environment": { "description": "Name of the environment the app deploys to.", "type": "string", "minLength": 1 },
        "tags": { "description": "Tags attached to the app.", "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "service": { "description": "The service definition, same fields as an app.yaml service.", "$ref": "#/$defs/service" }
      }
    },
    "domainSpec": {
      "type": "object",
      "required": ["app"],
      "additionalProperties": false,
      "properties": { "app": { "description": "Name of the app the domain points to.", "type": "string", "minLength": 1 } }
    },
    "pipelineSpec": {
      "type": "object",
      "required": ["app", "yaml"],
      "additionalProperties": false,
      "properties": {
        "app": { "description": "Name of the app the pipeline belongs to.", "type": "string", "minLength": 1 },
        "yaml": { "description": "Pipeline definition as YAML text.", "type": "string", "minLength": 1 },
        "enabled": { "description": "Whether the pipeline runs.", "type": "boolean" }
      }
    },
    "alertRuleSpec": {
      "type": "object",
      "required": ["app", "type"],
      "additionalProperties": false,
      "properties": {
        "app": { "description": "Name of the app the rule watches.", "type": "string", "minLength": 1 },
        "type": { "description": "Kind of alert rule.", "type": "string", "minLength": 1 },
        "metric": { "description": "Metric the rule evaluates.", "type": "string" },
        "comparator": { "description": "Comparison applied to the threshold.", "type": "string" },
        "threshold": { "description": "Value the metric is compared against.", "type": "number" },
        "for": { "description": "How long the condition must hold before alerting.", "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "restartCountThreshold": { "description": "Restart count that triggers a restart alert.", "type": "integer", "minimum": 0 },
        "restartWindow": { "description": "Window the restart count is measured over.", "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "channel": { "description": "Notification channel to alert.", "type": "string" },
        "enabled": { "description": "Whether the rule is active.", "type": "boolean" }
      }
    }
  }
}
