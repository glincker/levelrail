{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipeline:schema:1",
  "title": "Pipeline definition",
  "type": "object",
  "required": ["version", "jobs"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "on": { "$ref": "#/$defs/triggers" },
    "stages": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "env": { "$ref": "#/$defs/stringMap" },
    "concurrency": {
      "type": "object",
      "required": ["group"],
      "additionalProperties": false,
      "properties": {
        "group": { "type": "string", "minLength": 1 },
        "cancel_in_progress": { "type": "boolean" }
      }
    },
    "timeout": { "$ref": "#/$defs/duration" },
    "report_status": { "type": "boolean" },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["steps"],
        "additionalProperties": false,
        "properties": {
          "params": { "type": "array", "items": { "type": "string" } },
          "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
        }
      }
    },
    "jobs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/job" }
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "stringOrList": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
    },
    "duration": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$" },
    "refTrigger": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "branches": { "$ref": "#/$defs/stringOrList" },
        "paths": { "$ref": "#/$defs/stringOrList" },
        "paths_ignore": { "$ref": "#/$defs/stringOrList" }
      }
    },
    "prTrigger": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "branches": { "$ref": "#/$defs/stringOrList" },
        "types": { "$ref": "#/$defs/stringOrList" },
        "paths": { "$ref": "#/$defs/stringOrList" },
        "paths_ignore": { "$ref": "#/$defs/stringOrList" },
        "forks": { "enum": ["block", "approve", "allow"] }
      }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "push": { "$ref": "#/$defs/refTrigger" },
        "pull_request": { "$ref": "#/$defs/prTrigger" },
        "merge_group": { "$ref": "#/$defs/refTrigger" },
        "tag": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": { "patterns": { "$ref": "#/$defs/stringOrList" } }
        },
        "manual": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "inputs": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "description": { "type": "string" },
                  "default": { "type": ["string", "number", "boolean"] },
                  "required": { "type": "boolean" },
                  "options": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "schedule": { "type": "array", "items": { "type": "string" } },
        "api": { "type": "boolean" }
      }
    },
    "job": {
      "type": "object",
      "required": ["steps"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "stage": { "type": "string" },
        "needs": { "$ref": "#/$defs/stringOrList" },
        "if": { "type": "string" },
        "image": { "type": "string" },
        "node": { "type": "string" },
        "env": { "$ref": "#/$defs/stringMap" },
        "matrix": {
          "type": "object",
          "properties": {
            "include": { "type": "array", "items": { "$ref": "#/$defs/stringMap" } },
            "exclude": { "type": "array", "items": { "$ref": "#/$defs/stringMap" } }
          },
          "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean"] } }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "memory": { "type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi|K|M|G)?$" },
            "cpu": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "timeout": { "$ref": "#/$defs/duration" },
        "retries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "continue_on_error": { "type": "boolean" },
        "checkout": { "type": "boolean" },
        "cache": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "path"],
            "additionalProperties": false,
            "properties": { "key": { "type": "string", "minLength": 1 }, "path": { "type": "string", "pattern": "^/" } }
          }
        },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "name": { "type": "string" },
        "run": { "type": "string" },
        "uses": { "type": "string", "minLength": 1 },
        "with": { "$ref": "#/$defs/stringMap" },
        "env": { "$ref": "#/$defs/stringMap" },
        "secrets": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
        "if": { "type": "string" },
        "timeout": { "$ref": "#/$defs/duration" },
        "retries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "continue_on_error": { "type": "boolean" }
      },
      "oneOf": [{ "required": ["run"] }, { "required": ["uses"] }]
    }
  }
}
