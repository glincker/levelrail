      "session_token=set path=/ httponly=true secure=false samesite=2 expires=true maxage_neg=false"
    ],
    "Retry": false
  },
  {
    "Step": "session",
    "Status": 200,
    "Body": "{\"display_name\":\"first@example.test\",\"expires_at\":\"\\u003cvolatile\\u003e\",\"has_password\":true,\"username\":\"first@example.test\"}",
