<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark"><meta name="supported-color-schemes" content="light dark">
<title>[Acme Deploy] Reset your password</title>
<style>
@media (max-width:620px){.wrap{width:100%!important}.pad{padding:20px!important}}
@media (prefers-color-scheme:dark){
 body,.bg{background:#0b0f14!important}
 .card{background:#111821!important}
 .ink,.ink *{color:#e5e7eb!important}
 .callout{background:#1a2430!important}
 .btn{background:#112233!important}
 .muted,.muted *{color:#9ca3af!important}
}
</style></head>
<body class="bg" style="margin:0;padding:0;background:#f3f4f6">
<div style="display:none;max-height:0;overflow:hidden;opacity:0">Use this link to choose a new password.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="bg" style="background:#f3f4f6"><tr><td align="center" style="padding:24px 12px">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" class="wrap card" style="width:600px;max-width:100%;background:#ffffff;border-radius:8px;border-top:4px solid #112233;font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;font-size:15px">
<tr><td class="pad" style="padding:24px 32px 8px"><img src="https://cdn.example.com/logo.png" alt="Acme" style="display:block;max-width:100%;height:auto;border:0;margin:0 0 8px"><span class="ink" style="font-size:18px;font-weight:700;color:#111827">Acme</span></td></tr>
<tr><td class="pad" style="padding:8px 32px 24px"><p class="ink" style="margin:0 0 16px;line-height:1.6;color:#111827">Someone asked to reset the password for your Acme Deploy account.</p><p style="margin:0 0 20px"><a class="btn" href="https://deploy.example.com/reset-password?token=abc" style="display:inline-block;padding:12px 20px;background:#112233;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:600">Choose a new password</a></p><p class="ink" style="margin:0 0 16px;line-height:1.6;color:#111827">The link works once and expires in 7 days. If this was not you, ignore this email.</p></td></tr>
<tr><td class="pad muted" style="padding:16px 32px 24px;border-top:1px solid #e5e7eb;font-size:12px;line-height:1.5;color:#6b7280">(c) 2026 Acme Deploy<br>1 Main St<br>Springfield<br><a class="lnk" href="https://example.com/privacy" style="color:#6b7280;text-decoration:underline">Privacy</a> &middot; <a class="lnk" href="https://example.com/terms" style="color:#6b7280;text-decoration:underline">Terms</a><br>Powered by Acme</td></tr>
</table></td></tr></table></body></html>
