# Exported from Levelrail app "shop". Plain Docker Compose, no Levelrail needed.
# Domains are kept as x-domains so you can map them in your own proxy.
services:
  db:
    image: "postgres:16.4"
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_USER: ${POSTGRES_USER}
      SESSION_SECRET: ${DB_SESSION_SECRET}
    expose: ["5432"]
    volumes:
      - "shop_db:/var/lib/postgresql/data"
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "app"]
      interval: 5s
      retries: 5
  web:
    image: "ghcr.io/acme/shop:1.4"
    restart: always
    environment:
      API_TOKEN: ${API_TOKEN}
      DATABASE_URL: ${DATABASE_URL}
      DB_PASS: ${DB_PASS}
      LOG_LEVEL: ${LOG_LEVEL}
      NODE_ENV: ${NODE_ENV}
      SESSION_SECRET: ${WEB_SESSION_SECRET}
    ports:
      - "3000:3000"
    volumes:
      - "shop_uploads:/uploads"
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:3000/healthz >/dev/null || wget -q -O /dev/null http://localhost:3000/healthz || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 3
    depends_on:
      db:
        condition: service_healthy
    mem_limit: 536870912
    cpus: 0.5
    x-domains: ["shop.example.com"]

volumes:
  shop_db: {}
  shop_uploads: {}
