# Copy to .env and fill in the secrets before `docker compose up`.

# service: db
POSTGRES_DB=app
# secret: re-enter or restore from your backup
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_USER=app
# secret: re-enter or restore from your backup
DB_SESSION_SECRET=CHANGE_ME

# service: web
# secret: re-enter or restore from your backup
API_TOKEN=CHANGE_ME
# secret: re-enter or restore from your backup
DATABASE_URL=CHANGE_ME
# secret (database db field password): re-enter or restore from your backup
DB_PASS=CHANGE_ME
LOG_LEVEL=info
NODE_ENV=production
# secret: re-enter or restore from your backup
WEB_SESSION_SECRET=CHANGE_ME
