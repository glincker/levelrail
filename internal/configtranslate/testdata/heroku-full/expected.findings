warn heroku.buildpack.unsupported https://github.com/example/custom-buildpack
info heroku.process.port clock
info heroku.process.custom clock
info heroku.web.port web
info heroku.formation.size web
info heroku.process.port worker
warn heroku.release.predeploy release
warn heroku.script.postdeploy postdeploy
info heroku.script.unsupported test
info heroku.addon.database heroku-postgresql:essential-0
info heroku.addon.database heroku-redis:mini
info heroku.addon.logging papertrail:choklad
warn heroku.addon.scheduler scheduler:standard
warn heroku.addon.manual sendgrid:starter
info heroku.env.unset OPTIONAL_FLAG
info heroku.env.generator SECRET_KEY_BASE
info heroku.env.required STRIPE_KEY
