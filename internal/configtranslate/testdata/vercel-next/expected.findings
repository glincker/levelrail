warn vercel.build.custom 
warn vercel.build.env build.env
warn vercel.regions.multi iad1,fra1
blocker vercel.runtime.edge app/api/og/route.ts
info vercel.function.maxduration app/api/report/route.ts
info vercel.function.memory 
warn vercel.routing.server rewrites/redirects/headers
warn vercel.cron.http /api/cron/daily
warn vercel.cron.http /api/cron/daily?full=1
