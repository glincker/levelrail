#!/usr/sbin/nft -f
# Container egress baseline. Loaded before Docker so its chains never see an open window.
add table inet lr_isolation
delete table inet lr_isolation
table inet lr_isolation {
  chain forward {
    type filter hook forward priority -10; policy accept;
    ct state established,related accept
{{- range .DNSServers}}
    ip daddr {{.}} udp dport 53 accept
    ip daddr {{.}} tcp dport 53 accept
{{- end}}
    ip daddr {{.HostGateway}} drop
    ip daddr 172.16.0.0/12 ip daddr != {{.DockerPool}} drop
    ip daddr { 10.0.0.0/8, 192.168.0.0/16, 169.254.0.0/16, 100.64.0.0/10, 127.0.0.0/8, 224.0.0.0/4 } drop
    ip6 daddr { ::1, fc00::/7, fe80::/10 } drop
  }
}
