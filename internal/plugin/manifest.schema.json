{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "name", "version", "kind", "publisher", "image", "abilities"],
  "properties": {
    "api_version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
    "version": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,39}$" },
    "kind": { "enum": ["notification_channel", "panel_provider", "dns_provider"] },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 400 },
    "image": { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$" },
    "abilities": { "type": "array", "items": { "type": "string" } },
    "outbound_hosts": { "type": ["array", "null"], "maxItems": 16, "items": { "type": "string" } },
    "outbound_hosts_from_config": { "type": ["array", "null"], "maxItems": 8, "items": { "type": "string" } },
    "contributes": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": ["array", "null"],
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "panel"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
              "description": { "type": "string", "maxLength": 200 },
              "panel": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
              "action": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" }
            }
          }
        },
        "panels": {
          "type": ["array", "null"],
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 80 },
              "description": { "type": "string", "maxLength": 300 },
              "slot": { "enum": ["plugins", "app-detail", "settings", "dashboard"] },
              "source": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["id", "abilities"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
                  "abilities": { "type": "array", "minItems": 1, "items": { "enum": ["read"] } }
                }
              },
              "widgets": {
                "type": ["array", "null"],
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type"],
                  "properties": {
                    "type": { "enum": ["stat", "table", "list", "chart", "markdown", "status", "button"] },
                    "title": { "type": "string", "maxLength": 80 },
                    "field": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,40}(\\.[A-Za-z0-9_]{1,40}){0,5}$" },
                    "unit": { "type": "string", "maxLength": 16 },
                    "columns": {
                      "type": ["array", "null"],
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["key", "label"],
                        "properties": {
                          "key": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,40}$" },
                          "label": { "type": "string", "minLength": 1, "maxLength": 60 }
                        }
                      }
                    },
                    "label_key": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,40}$" },
                    "value_key": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,40}$" },
                    "action": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
                    "label": { "type": "string", "maxLength": 60 },
                    "confirm": { "type": "string", "maxLength": 200 }
                  }
                }
              },
              "rows": {
                "type": ["array", "null"],
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "value"],
                  "properties": {
                    "label": { "type": "string", "minLength": 1, "maxLength": 60 },
                    "value": { "type": "string", "maxLength": 200 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
