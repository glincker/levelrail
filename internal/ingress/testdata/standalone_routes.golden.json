[
  {
    "match": [
      {
        "host": [
          "port.example.com"
        ]
      }
    ],
    "handle": [
      {
        "handler": "reverse_proxy",
        "upstreams": [
          {
            "dial": "127.0.0.1:3000"
          }
        ]
      }
    ]
  },
  {
    "match": [
      {
        "host": [
          "address.example.com"
        ]
      }
    ],
    "handle": [
      {
        "handler": "rewrite",
        "strip_path_prefix": "/app"
      },
      {
        "handler": "reverse_proxy",
        "upstreams": [
          {
            "dial": "10.0.0.5:8080"
          }
        ],
        "transport": {
          "protocol": "http",
          "dial_timeout": "5s",
          "response_header_timeout": "1m30s"
        }
      }
    ]
  },
  {
    "match": [
      {
        "host": [
          "url.example.com"
        ]
      }
    ],
    "handle": [
      {
        "handler": "rewrite",
        "uri": "/base{http.request.uri}"
      },
      {
        "handler": "reverse_proxy",
        "upstreams": [
          {
            "dial": "203.0.113.9:8443"
          }
        ],
        "transport": {
          "protocol": "http",
          "tls": {
            "server_name": "upstream.example.org"
          }
        },
        "headers": {
          "request": {
            "set": {
              "Host": [
                "upstream.example.org:8443"
              ]
            }
          }
        }
      }
    ]
  },
  {
    "match": [
      {
        "host": [
          "app.example.com"
        ]
      }
    ],
    "handle": [
      {
        "handler": "reverse_proxy",
        "upstreams": [
          {
            "dial": "127.0.0.1:49153"
          }
        ],
        "headers": {
          "request": {
            "delete": [
              "Upgrade"
            ]
          }
        }
      }
    ]
  },
  {
    "match": [
      {
        "host": [
          "container.example.com"
        ]
      }
    ],
    "handle": [
      {
        "handler": "reverse_proxy",
        "upstreams": [
          {
            "dial": "172.18.0.4:8081"
          }
        ],
        "transport": {
          "protocol": "http",
          "tls": {
            "insecure_skip_verify": true
          }
        },
        "headers": {
          "request": {
            "set": {
              "Host": [
                "{http.reverse_proxy.upstream.hostport}"
              ]
            }
          }
        }
      }
    ]
  }
]
