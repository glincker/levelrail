<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Create @STATE_DIR@ and @LOG_DIR@ first (mkdir -p), or the job exits 78 with no log.
     Replace every @PLACEHOLDER@ before loading. The join token is deliberately not here:
     enrol once in the foreground, the saved identity file is what this service uses. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.levelrail.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>@BINARY@</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>APP_CONTROL_PLANE_ADDR</key>
		<string>@CONTROL_PLANE_ADDR@</string>
		<key>APP_CA_FINGERPRINT</key>
		<string>@CA_FINGERPRINT@</string>
		<key>APP_AGENT_IDENTITY_FILE</key>
		<string>@STATE_DIR@/identity.json</string>
		<key>PATH</key>
		<string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>@STATE_DIR@</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- Placeholder: seconds between respawns, so an unenrolled start does not loop every 10 seconds. -->
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>@LOG_DIR@/levelrail-agent.log</string>
	<key>StandardErrorPath</key>
	<string>@LOG_DIR@/levelrail-agent.log</string>
</dict>
</plist>
