# Settings for the levelrail-agent service. Fill in the first three for the
# first enrollment, then: systemctl enable --now levelrail-agent
#
# Control plane address, host:port of the agent listener.
#APP_CONTROL_PLANE_ADDR=control-plane-host:9443
# One-time join token and the CA fingerprint printed next to it.
#APP_JOIN_TOKEN=
#APP_CA_FINGERPRINT=
# Name shown in the dashboard. Defaults to the hostname.
#APP_NODE_NAME=
