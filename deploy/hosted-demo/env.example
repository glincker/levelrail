# Copy to /etc/levelrail-demo/env (mode 0640, root:levelrail-demo). No secrets belong here.
APP_DEMO_MODE=1
APP_DATA_DIR=/var/lib/levelrail-demo/data
APP_HTTP_ADDR=127.0.0.1:8080
# Shown in the dashboard banner; match the reseed timer cadence.
APP_DEMO_RESET_INTERVAL=30m
# Seed used by reseed.sh.
DEMO_SEED=1
