# syntax=docker/dockerfile:1
ARG VERSION=dev

FROM golang:1.26-alpine AS build
ARG VERSION
WORKDIR /src
COPY go.mod go.sum ./
COPY kit/go.mod ./kit/
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build \
    -ldflags "-X github.com/GLINCKER/levelrail/internal/version.Version=${VERSION}" \
    -o /levelrail-mcp ./cmd/levelrail-mcp

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /levelrail-mcp /levelrail-mcp
COPY --from=build /src/brand.yaml /brand.yaml
# stdio by default; read APP_API_URL and APP_API_TOKEN from the environment.
ENTRYPOINT ["/levelrail-mcp"]
