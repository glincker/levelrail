{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Levelrail",
  "description": "Self-hosted deployment platform. Push to git, get a running app with TLS, logs, metrics and rollback. One Go binary, no Kubernetes.",
  "colors": {
    "primary": "#107292",
    "light": "#2FB3DC",
    "dark": "#084F67"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#000000"
    }
  },
  "favicon": "/public/favicon.svg",
  "logo": {
    "light": "/assets/brand/wordmark-light.svg",
    "dark": "/assets/brand/wordmark-dark.svg",
    "href": "https://levelrail.com"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "styling": {
    "codeblocks": "dark"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "mcp"
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "icon": "globe",
        "href": "https://levelrail.com"
      },
      {
        "label": "Changelog",
        "icon": "clock-rotate-left",
        "href": "/changelog"
      },
      {
        "label": "GitHub",
        "icon": "github",
        "href": "https://github.com/glincker/levelrail"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/getting-started"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/glincker/levelrail",
      "x": "https://x.com/thegdsks",
      "website": "https://levelrail.com"
    }
