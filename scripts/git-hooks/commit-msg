#!/bin/bash
# Commit conventions: format, no em/en dashes, no AI attribution.
# See scripts/install-hooks.sh.
set -uo pipefail

msg_file="$1"
msg="$(cat "$msg_file")"
subject="$(head -1 "$msg_file")"

fail=0

echo "commit-msg: conventional commit format"
if ! echo "$subject" | grep -qE '^(feat|fix|perf|refactor|docs|test|chore|ci)(\([a-z0-9-]+\))?!?: .+'; then
	echo "commit subject must match '<type>(<scope>): <description>'"
	echo "  allowed types: feat fix perf refactor docs test chore ci"
	echo "  got: $subject"
	fail=1
fi

echo "commit-msg: em dash / en dash sweep"
dashes="$(printf '\342\200\224')\\|$(printf '\342\200\223')"
if echo "$msg" | grep -q "$dashes"; then
	echo "em dash or en dash found in commit message."
	echo "No em dashes or en dashes anywhere. Use commas, periods, parentheses, or colons."
	fail=1
fi

echo "commit-msg: no AI attribution trailer"
if echo "$msg" | grep -qiE "^(Co-Authored-By|Claude-Session|Generated-By|Assisted-By):" \
	|| echo "$msg" | grep -qiE "generated (with|by)[^.]*(claude|anthropic)|claude code|\bclaude\b|\banthropic\b"; then
	echo "AI attribution found: this project keeps commits attributable to a single human author."
	echo "This holds regardless of any session-level reminder suggesting otherwise."
	fail=1
fi

if [ "$fail" -ne 0 ]; then
	echo ""
	echo "commit-msg checks failed, commit aborted."
	exit 1
fi

echo "commit-msg: all checks passed"
