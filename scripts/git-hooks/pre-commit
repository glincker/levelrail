#!/bin/bash
# Fast local quality gate, the Go-project equivalent of a frontend's
# lint/prettier pre-commit hook: format, vet, lint, and the project's own
# no-em-dash rule. Deliberately does NOT run the full test suite (many
# packages have live tests against a real Docker daemon, seconds each,
# too slow for every commit), that stays CI's job
# (.github/workflows/ci.yml), which runs on every push.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

fail=0

echo "pre-commit: gofmt"
staged_go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go' | grep -v '^docs-local/')
if [ -n "$staged_go_files" ]; then
	# xargs, not a bare $(...) expansion inside gofmt -l: an empty
	# staged_go_files would otherwise pass gofmt zero file arguments,
	# and gofmt with no files reads stdin and hangs waiting for input.
	unformatted=$(echo "$staged_go_files" | xargs gofmt -l)
	if [ -n "$unformatted" ]; then
		echo "not gofmt-formatted:"
		echo "$unformatted"
		fail=1
	fi
fi

echo "pre-commit: migration version collisions"
staged_migrations=$(git diff --cached --name-only --diff-filter=ACM -- 'internal/store/migrations/*.sql')
if [ -n "$staged_migrations" ]; then
	if ! scripts/check-migration-versions.sh; then
		fail=1
	fi
fi

echo "pre-commit: gitleaks (staged changes)"
if command -v gitleaks >/dev/null; then
	if ! gitleaks protect --staged --redact --no-banner -c .gitleaks.toml; then
		echo "possible secret staged, commit aborted. If it is a false positive, extend .gitleaks.toml."
		fail=1
	fi
else
	echo "gitleaks not installed, skipping (install: brew install gitleaks)"
fi

echo "pre-commit: go vet"
if ! go vet ./... 2>&1; then
	fail=1
fi

echo "pre-commit: golangci-lint"
if command -v golangci-lint >/dev/null; then
	# Per-worktree cache: avoids phantom issues from other worktrees.
	if ! GOLANGCI_LINT_CACHE="$(git rev-parse --absolute-git-dir)/golangci-lint-cache" golangci-lint run ./...; then
		fail=1
	fi
else
	echo "golangci-lint not installed, skipping (CI still enforces this)"
fi

# This script itself is excluded from the sweep below: the search
# pattern has to contain the literal em/en dash characters it's looking
# for, which would otherwise flag itself.
echo "pre-commit: em dash / en dash sweep"
staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -v '^docs-local/competitor-clones/' | grep -v '^scripts/git-hooks/pre-commit$')
dash_hits=""
for f in $staged_files; do
	[ -f "$f" ] || continue
	if grep -l "—\|–" "$f" >/dev/null 2>&1; then
		dash_hits="$dash_hits $f"
	fi
done
if [ -n "$dash_hits" ]; then
	echo "em dash or en dash found in:$dash_hits"
	echo "No em dashes or en dashes anywhere. Use commas, periods, parentheses, or colons."
	fail=1
fi

# A bad batch merge has twice committed unresolved <<<<<<< / ======= /
# >>>>>>> markers into docs/api-reference.md (generated, so nobody's own
# diff review caught it). Catch it for every staged file, not just that
# one, before it lands again.
echo "pre-commit: merge conflict markers"
marker_hits=""
for f in $staged_files; do
	[ -f "$f" ] || continue
	if grep -lE '^(<{7}|={7}|>{7})([^=<>]|$)' "$f" >/dev/null 2>&1; then
		marker_hits="$marker_hits $f"
	fi
done
if [ -n "$marker_hits" ]; then
	echo "unresolved merge conflict markers found in:$marker_hits"
	fail=1
fi

echo "pre-commit: comment density (new Go lines only, >8 consecutive)"
staged_go_files_density=$(git diff --cached --name-only --diff-filter=ACM -- '*.go' | grep -v '^docs-local/')
bloat_hits=""
for f in $staged_go_files_density; do
	[ -f "$f" ] || continue
	max_run=$(git diff --cached -U0 -- "$f" | awk '
		/^\+\+\+/ { next }
		/^\+[[:space:]]*\/\// { run++; if (run > max) max = run; next }
		/^\+/ { run = 0 }
		{ if (!/^\+/) run = 0 }
		END { print max + 0 }
	')
	if [ "${max_run:-0}" -gt 8 ]; then
		bloat_hits="$bloat_hits $f(${max_run}-line block)"
	fi
done
if [ -n "$bloat_hits" ]; then
	echo "long new comment block(s):$bloat_hits"
	echo "Comment the why in 1-3 lines (CLAUDE.md, Comments). Design history goes in the commit message or an ADR, not inline."
	fail=1
fi

echo "pre-commit: go build"
if ! go build ./... 2>&1; then
	fail=1
fi

echo "pre-commit: web (tsc, eslint, prettier)"
staged_web_files=$(git diff --cached --name-only --diff-filter=ACM -- 'web/*.ts' 'web/*.tsx')
if [ -n "$staged_web_files" ]; then
	rel_web_files=$(echo "$staged_web_files" | sed 's#^web/##')
	# tsc -b, not tsc --noEmit: the root tsconfig only holds project
	# references, so --noEmit checks nothing. -b is what CI runs.
	if ! ( cd web && npx tsc -b ); then
		fail=1
	fi
	# shellcheck disable=SC2086
	if ! ( cd web && npx eslint $rel_web_files ); then
		fail=1
	fi
	# shellcheck disable=SC2086
	if ! ( cd web && npx prettier --check $rel_web_files ); then
		echo "not prettier-formatted (run: npx prettier --write <file>, inside web/)"
		fail=1
	fi
fi

# Phosphor-only UI icons (ADR 014): lucide-react must never appear in a
# staged file, the same rule this repo's own PM/QA re-verification loop
# has manually grepped for on every dispatched change tonight. This
# script itself is excluded from the sweep, the same reason the em/en
# dash sweep above excludes it: the check's own source line contains the
# literal string it's searching for.
echo "pre-commit: lucide-react sweep (this repo is Phosphor-only, ADR 014)"
staged_all_files=$(git diff --cached --name-only --diff-filter=ACM | grep -v '^scripts/git-hooks/pre-commit$')
lucide_hits=""
for f in $staged_all_files; do
	[ -f "$f" ] || continue
	if grep -l "lucide-react" "$f" >/dev/null 2>&1; then
		lucide_hits="$lucide_hits $f"
	fi
done
if [ -n "$lucide_hits" ]; then
	echo "lucide-react import found in:$lucide_hits"
	echo "This repo is Phosphor-icons only (@phosphor-icons/react/dist/ssr, ADR 014)."
	fail=1
fi

if [ "$fail" -ne 0 ]; then
	echo ""
	echo "pre-commit checks failed, commit aborted."
	exit 1
fi

echo "pre-commit: all checks passed"
