#!/bin/bash
# Fast local quality gate, the Go-project equivalent of a frontend's
# lint/prettier pre-commit hook: format, vet, lint, and the project's own
# no-em-dash rule. Deliberately does NOT run the full test suite (many
# packages have live tests against a real Docker daemon, seconds each,
# too slow for every commit), that stays CI's job
# (.github/workflows/ci.yml), which runs on every push.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

fail=0

echo "pre-commit: gofmt"
staged_go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go' | grep -v '^docs-local/')
if [ -n "$staged_go_files" ]; then
	# xargs, not a bare $(...) expansion inside gofmt -l: an empty
	# staged_go_files would otherwise pass gofmt zero file arguments,
	# and gofmt with no files reads stdin and hangs waiting for input.
	unformatted=$(echo "$staged_go_files" | xargs gofmt -l)
	if [ -n "$unformatted" ]; then
		echo "not gofmt-formatted:"
		echo "$unformatted"
		fail=1
	fi
fi

echo "pre-commit: migration version collisions"
staged_migrations=$(git diff --cached --name-only --diff-filter=ACM -- 'internal/store/migrations/*.sql')
if [ -n "$staged_migrations" ]; then
	if ! scripts/check-migration-versions.sh; then
		fail=1
	fi
fi

echo "pre-commit: gitleaks (staged changes)"
if command -v gitleaks >/dev/null; then
	if ! gitleaks protect --staged --redact --no-banner -c .gitleaks.toml; then
		echo "possible secret staged, commit aborted. If it is a false positive, extend .gitleaks.toml."
		fail=1
	fi
else
	echo "gitleaks not installed, skipping (install: brew install gitleaks)"
fi

# Go checks run only for staged Go files, on their packages only. The full
# build (every dependent) runs once per push in pre-push, and CI lints the
# whole tree, so a commit pays for what it touched, not for the repo.
go_pkg_dirs=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go' ':!tools/*' ':!kit/*' ':!integrations/terraform-provider/*' ':!docs-local/*' | xargs -n1 dirname 2>/dev/null | sort -u | while read -r d; do [ -d "$d" ] && echo "./$d"; done)
go_mod_staged=$(git diff --cached --name-only -- go.mod go.sum)

# vet and golangci-lint are independent, so they run side by side; vet's
# output is printed after lint so the two logs never interleave.
echo "pre-commit: go vet + golangci-lint (changed packages, lint on new issues only)"
vet_log="$(mktemp)"
vet_pid=""
if [ -n "$go_pkg_dirs" ] || [ -n "$go_mod_staged" ]; then
	# shellcheck disable=SC2086
	( go vet ${go_pkg_dirs:-./...} ) >"$vet_log" 2>&1 &
	vet_pid=$!
else
	echo "no staged Go files, vet skipped"
fi

if [ -z "$go_pkg_dirs" ]; then
	echo "no staged Go files, lint skipped"
elif command -v golangci-lint >/dev/null; then
	# Parallel runners are allowed so agents never queue behind each other; the
	# cache is shared across worktrees (its writes are atomic). If an older
	# binary still reports the single-run lock, wait a bounded time and retry,
	# then fail loudly: lint is never skipped silently.
	lint_cache="${LEVELRAIL_LINT_CACHE:-$(git rev-parse --path-format=absolute --git-common-dir)/golangci-lint-cache}"
	lint_wait="${APP_LINT_LOCK_WAIT_SECONDS:-300}"
	lint_log="$(mktemp)"
	lint_start="$(date +%s)"
	while :; do
		# shellcheck disable=SC2086
		GOLANGCI_LINT_CACHE="$lint_cache" golangci-lint run --allow-parallel-runners --new-from-rev=HEAD $go_pkg_dirs >"$lint_log" 2>&1
		lint_rc=$?
		cat "$lint_log"
		if [ "$lint_rc" -eq 0 ]; then
			break
		fi
		if grep -q "parallel golangci-lint is running" "$lint_log"; then
			if [ $(($(date +%s) - lint_start)) -ge "$lint_wait" ]; then
				echo "golangci-lint lock still held after ${lint_wait}s (APP_LINT_LOCK_WAIT_SECONDS), lint NOT run, commit aborted."
				fail=1
				break
			fi
			echo "golangci-lint lock held by another run, retrying in 5s (limit ${lint_wait}s)"
			sleep 5
			continue
		fi
		fail=1
		break
	done
	rm -f "$lint_log"
else
	echo "golangci-lint not installed, skipping (CI still enforces this)"
fi

if [ -n "$vet_pid" ]; then
	if ! wait "$vet_pid"; then
		cat "$vet_log"
		fail=1
	fi
fi
rm -f "$vet_log"

echo "pre-commit: kit (vet, lint, build, brand strings)"
staged_kit_files=$(git diff --cached --name-only --diff-filter=ACM -- 'kit/')
if [ -n "$staged_kit_files" ]; then
	if ! go -C kit vet ./... 2>&1; then
		fail=1
	fi
	if ! go -C kit build ./... 2>&1; then
		fail=1
	fi
	if command -v golangci-lint >/dev/null; then
		if ! (cd kit && GOLANGCI_LINT_CACHE="$(git rev-parse --absolute-git-dir)/golangci-lint-cache" golangci-lint run ./...); then
			fail=1
		fi
	fi
	staged_kit_go=$(echo "$staged_kit_files" | grep '\.go$' || true)
	if [ -n "$staged_kit_go" ]; then
		# shellcheck disable=SC2086
		if ! scripts/check-brand-strings.sh $staged_kit_go; then
			fail=1
		fi
	fi
fi

echo "pre-commit: terraform-provider (vet, build, brand strings)"
staged_tf_files=$(git diff --cached --name-only --diff-filter=ACM -- 'integrations/terraform-provider/')
if [ -n "$staged_tf_files" ]; then
	if ! go -C integrations/terraform-provider vet ./... 2>&1; then
		fail=1
	fi
	if ! go -C integrations/terraform-provider build ./... 2>&1; then
		fail=1
	fi
	if ! scripts/check-brand-strings.sh; then
		fail=1
	fi
fi

# This script itself is excluded from the sweep below: the search
# pattern has to contain the literal em/en dash characters it's looking
# for, which would otherwise flag itself.
echo "pre-commit: em dash / en dash sweep"
staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -v '^docs-local/competitor-clones/' | grep -v '^scripts/git-hooks/pre-commit$')
dash_hits=""
for f in $staged_files; do
	[ -f "$f" ] || continue
	if grep -l "—\|–" "$f" >/dev/null 2>&1; then
		dash_hits="$dash_hits $f"
	fi
done
if [ -n "$dash_hits" ]; then
	echo "em dash or en dash found in:$dash_hits"
	echo "No em dashes or en dashes anywhere. Use commas, periods, parentheses, or colons."
	fail=1
fi

# A bad batch merge has twice committed unresolved <<<<<<< / ======= /
# >>>>>>> markers into docs/api-reference.md (generated, so nobody's own
# diff review caught it). Catch it for every staged file, not just that
# one, before it lands again.
echo "pre-commit: merge conflict markers"
marker_hits=""
for f in $staged_files; do
	[ -f "$f" ] || continue
	if grep -lE '^(<{7}|={7}|>{7})([^=<>]|$)' "$f" >/dev/null 2>&1; then
		marker_hits="$marker_hits $f"
	fi
done
if [ -n "$marker_hits" ]; then
	echo "unresolved merge conflict markers found in:$marker_hits"
	fail=1
fi

echo "pre-commit: comment density (new Go/TS/TSX lines only, >8 consecutive)"
staged_go_files_density=$(git diff --cached --name-only --diff-filter=ACM -- '*.go' 'web/*.ts' 'web/*.tsx' | grep -v '^docs-local/')
bloat_hits=""
for f in $staged_go_files_density; do
	[ -f "$f" ] || continue
	max_run=$(git diff --cached -U0 -- "$f" | awk '
		/^\+\+\+/ { next }
		/^\+[[:space:]]*(\/\/|\*)/ { run++; if (run > max) max = run; next }
		/^\+/ { run = 0 }
		{ if (!/^\+/) run = 0 }
		END { print max + 0 }
	')
	if [ "${max_run:-0}" -gt 8 ]; then
		bloat_hits="$bloat_hits $f(${max_run}-line block)"
	fi
done
if [ -n "$bloat_hits" ]; then
	echo "long new comment block(s):$bloat_hits"
	echo "Comment the why in 1-3 lines (CLAUDE.md, Comments). Design history goes in the commit message or an ADR, not inline."
	fail=1
fi

echo "pre-commit: go build (changed packages)"
if [ -n "$go_pkg_dirs" ]; then
	# shellcheck disable=SC2086
	if ! go build $go_pkg_dirs 2>&1; then
		fail=1
	fi
fi

echo "pre-commit: web (tsc, eslint, prettier)"
staged_web_files=$(git diff --cached --name-only --diff-filter=ACM -- 'web/*.ts' 'web/*.tsx')
if [ -n "$staged_web_files" ]; then
	rel_web_files=$(echo "$staged_web_files" | sed 's#^web/##')
	# routeTree.gen.ts is gitignored and goes stale whenever src/routes
	# changes; regenerate it (about 0.5s) instead of failing tsc -b.
	if ! scripts/ensure-route-tree.sh; then
		fail=1
	fi
	# tsc -b, not tsc --noEmit: the root tsconfig only holds project
	# references, so --noEmit checks nothing. -b is what CI runs. It is the
	# long pole, so eslint and prettier (under 10s together) run beside it.
	tsc_log="$(mktemp)"
	( cd web && npx tsc -b ) >"$tsc_log" 2>&1 &
	tsc_pid=$!
	lint_rc=0
	# shellcheck disable=SC2086
	( cd web && npx eslint $rel_web_files ) || lint_rc=1
	# shellcheck disable=SC2086
	if ! ( cd web && npx prettier --check $rel_web_files ); then
		echo "not prettier-formatted (run: npx prettier --write <file>, inside web/)"
		lint_rc=1
	fi
	tsc_rc=0
	wait "$tsc_pid" || tsc_rc=$?
	cat "$tsc_log"
	rm -f "$tsc_log"
	[ "$tsc_rc" -eq 0 ] || fail=1
	[ "$lint_rc" -eq 0 ] || fail=1
fi

# thesvg-only UI icons: lucide-react and Phosphor must never appear in a
# staged file, the same rule this repo's own PM/QA re-verification loop
# has manually grepped for on every dispatched change tonight. This
# script itself is excluded from the sweep, the same reason the em/en
# dash sweep above excludes it: the check's own source line contains the
# literal string it's searching for.
echo "pre-commit: icon library sweep (UI icons are @thesvg/ui-react only)"
# Lockfiles list transitive dependencies (e.g. @glinui/ui pulls lucide-react); the rule is about our own imports.
staged_all_files=$(git diff --cached --name-only --diff-filter=ACM | grep -v -e '^scripts/git-hooks/pre-commit$' -e '^scripts/check-icon-rules\.sh$' -e '^adr/014-phosphor-icons\.md$' -e '^CHANGELOG\.md$' -e '^docs/changelog\.mdx$' -e 'package-lock\.json$')
lucide_hits=""
for f in $staged_all_files; do
	[ -f "$f" ] || continue
	if grep -l -E "lucide-react|@phosphor-icons" "$f" >/dev/null 2>&1; then
		lucide_hits="$lucide_hits $f"
	fi
done
if [ -n "$lucide_hits" ]; then
	echo "lucide-react or Phosphor import found in:$lucide_hits"
	echo "UI icons come from @thesvg/ui-react only (glass look)."
	fail=1
fi

# Icon and logo rules: brand marks from @thesvg/react through BrandIcon, UI
# icons from @thesvg/ui-react (scripts/check-icon-rules.sh).
echo "pre-commit: icon and logo rules"
staged_web_src=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^web/src/.*\.(ts|tsx)$')
if [ -n "$staged_web_src" ]; then
	# shellcheck disable=SC2086
	if ! scripts/check-icon-rules.sh $staged_web_src; then
		fail=1
	fi
fi

# No literal JSX text in new web files (scripts/check-i18n.sh, docs/i18n.md).
echo "pre-commit: i18n gate"
if ! scripts/check-i18n.sh; then
	fail=1
fi

# The installer CI job runs this exact shellcheck command and fails on info-level
# findings, which cost a full CI cycle to discover. Keep the file list in sync
# with the install.sh job in .github/workflows/ci.yml.
echo "pre-commit: shellcheck (installer scripts)"
install_scripts="install.sh install-cli.sh scripts/test-install-sh.sh scripts/test-install-cli.sh"
staged_install_scripts=""
for f in $install_scripts; do
	if git diff --cached --name-only --diff-filter=ACM -- "$f" | grep -q .; then
		staged_install_scripts="$staged_install_scripts $f"
	fi
done
if [ -n "$staged_install_scripts" ]; then
	if command -v shellcheck >/dev/null 2>&1; then
		# shellcheck disable=SC2086
		if ! shellcheck -s sh $install_scripts; then
			echo "shellcheck findings in the installer scripts (CI fails on these too)"
			fail=1
		fi
	else
		echo "shellcheck is not installed: skipping (CI will run it; brew install shellcheck)"
	fi
fi

if [ "$fail" -ne 0 ]; then
	echo ""
	echo "pre-commit checks failed, commit aborted."
	exit 1
fi

echo "pre-commit: all checks passed"
