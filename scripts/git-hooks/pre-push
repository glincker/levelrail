#!/bin/bash
# The heavier gate pre-commit skips: a full -race test run plus the
# coverage threshold. Runs the thorough check CI's PR lane no longer
# does, once per push rather than once per commit.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

fail=0
coverage_out="$(mktemp -t levelrail-coverage.XXXXXX)"
trap 'rm -f "$coverage_out"' EXIT

echo "pre-push: go build"
if ! go build ./... 2>&1; then
	fail=1
fi

if [ "$fail" -eq 0 ]; then
	# -short skips the tests marked testing.Short() (flaky under load,
	# covered by nightly.yml instead); -race stays on.
	echo "pre-push: go test -race -short (with coverage)"
	if ! go test ./... -race -short -coverprofile="$coverage_out" 2>&1; then
		fail=1
	fi
fi

if [ "$fail" -eq 0 ] && [ -f "$coverage_out" ]; then
	echo "pre-push: coverage gate (internal/, 70%)"
	if ! scripts/check-coverage.sh "$coverage_out" internal/ 70; then
		fail=1
	fi
fi

if [ "$fail" -ne 0 ]; then
	echo ""
	echo "pre-push checks failed, push aborted."
	exit 1
fi

echo "pre-push: all checks passed"
