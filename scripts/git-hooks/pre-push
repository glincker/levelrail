#!/bin/bash
# The heavier gate pre-commit skips: a real test run plus the coverage
# threshold, once per push rather than once per commit.
#
# Scoped to scripts/affected-go-packages.sh's affected set rather than
# always testing ./... : a push that only touched, say,
# internal/vault/cli-docs no longer pays for internal/api's own
# multi-minute suite. Falls back to the full ./... run whenever the
# affected-set script says "ALL" or can't be trusted (no jq, detached
# HEAD with no upstream, etc.): never silently narrows scope on a tool
# that isn't actually available.
#
# No -race here, matching CI's own PR-lane precedent (ci.yml's
# Go test lanes all skip -race deliberately, calling out
# internal/api as "the slowest package by far" even without it): race
# detection can turn that same package into tens of minutes locally.
# nightly.yml's full, no-short, -race sweep is the actual safety net
# for what both this hook and CI's fast lane skip.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

# Shared Go build cache across worktrees: trimpath keeps the package dir out of action IDs.
case " ${GOFLAGS:-} " in *" -trimpath "*) ;; *) export GOFLAGS="${GOFLAGS:+$GOFLAGS }-trimpath" ;; esac
# Heavy jobs queue through machine-wide slots; fd 3 keeps the wait line visible when output is captured.
exec 3>&2
# shellcheck source=scripts/lib/slot.sh
. scripts/lib/slot.sh

# git exports these to hooks; tests that spawn their own git repos inherit
# them and act on this checkout instead (TestCheckPushed fails in foreground).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY \
	GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE GIT_QUARANTINE_PATH

# Opt-in: detach the checks and return at once, but never for pushes to main or master.
if [ "${LEVELRAIL_PUSH_BACKGROUND:-off}" = on ] && [ -z "${LEVELRAIL_PUSH_DETACHED:-}" ]; then
	to_main=0
	while read -r _ _ remote_ref _; do
		case "$remote_ref" in refs/heads/main | refs/heads/master) to_main=1 ;; esac
	done
	if [ "$to_main" -eq 0 ]; then
		bg_log="$(git rev-parse --git-dir)/pre-push-last.log"
		LEVELRAIL_PUSH_DETACHED=1 nohup "$0" "$@" </dev/null >"$bg_log" 2>&1 &
		echo "pre-push: checks running in background, log: $bg_log"
		exit 0
	fi
fi

fail=0
coverage_out="$(mktemp -t levelrail-coverage.XXXXXX)"
push_log="$(mktemp -t levelrail-push-log.XXXXXX)"
build_log=""
build_pid=""
pkg_pid=""
trap 'rm -f "$coverage_out" "$push_log" "$build_log"' EXIT
# Captured for reuse as the PR-comment body below.
exec > >(tee -a "$push_log") 2>&1

# Compare against the nearest integration branch (an open release branch or main),
# not always main: a release line far ahead of main would make every push look huge.
base_ref="${LEVELRAIL_PUSH_BASE:-}"
if [ -z "$base_ref" ]; then
	best_n=""
	for r in $(git for-each-ref --format='%(refname:short)' 'refs/remotes/origin/release/*') origin/main; do
		mb="$(git merge-base HEAD "$r" 2>/dev/null)" || continue
		n="$(git rev-list --count "$mb..HEAD")"
		if [ -z "$best_n" ] || [ "$n" -lt "$best_n" ]; then
			base_ref="$r"
			best_n="$n"
		fi
	done
	base_ref="${base_ref:-origin/main}"
fi

# Coverage and web tests are CI's job (the required gate); opt in locally with =on.
cov_on="${LEVELRAIL_PUSH_COVERAGE:-off}"
web_tests_on="${LEVELRAIL_PUSH_WEB_TESTS:-off}"

echo "pre-push: migration version collisions"
if ! scripts/check-migration-versions.sh; then
	fail=1
fi

# Stale generated API docs cost a CI cycle; the check only runs when a routes
# file or the generated outputs changed in this push.
if [ "$fail" -eq 0 ] && git rev-parse --verify --quiet "$base_ref" >/dev/null \
	&& git diff --name-only "$base_ref...HEAD" 2>/dev/null | grep -qE '^(internal/api/[a-z0-9_]*routes[a-z0-9_]*\.go|internal/api/openapi_gen\.go|docs/api-reference\.md|docs/public/openapi\.json)$'; then
	echo "pre-push: API reference and OpenAPI up to date"
	if ! go run ./scripts/gen-api-reference -check 2>&1; then
		echo "API reference or OpenAPI is stale. Run: go run ./scripts/gen-api-reference  (then commit docs/api-reference.md, docs/public/openapi.json, internal/api/openapi_gen.go)"
		fail=1
	fi
fi

scope="ALL"
if [ "$fail" -eq 0 ] && command -v jq >/dev/null 2>&1; then
	# Best-effort: a fetch failure (offline, no network) just means the
	# affected-set is computed against whatever the base ref is already
	# known locally, which only risks over-selecting, never under.
	git fetch origin "${base_ref#origin/}" --quiet 2>/dev/null || true
	if git rev-parse --verify --quiet $base_ref >/dev/null; then
		affected_out="$(scripts/affected-go-packages.sh $base_ref 2>/dev/null || echo ALL)"
		if [ -z "$affected_out" ]; then
			scope="NONE"
		elif [ "$affected_out" != "ALL" ]; then
			scope="$affected_out"
		fi
	fi
fi

push_scope="${LEVELRAIL_PUSH_SCOPE:-fast}"

# A push with no Go-affecting change (web, docs) cannot break the Go build,
# and go build ./... costs ~18s on a warm cache.
if [ "$fail" -eq 0 ] && [ "$scope" != "NONE" ]; then
	# Runs beside the tests (their compiles share the build cache) and is
	# collected before the verdict, so it no longer adds its own serial 18s.
	echo "pre-push: go build (running alongside the tests)"
	build_log="$(mktemp -t levelrail-push-build.XXXXXX)"
	slot_run build go build ./... >"$build_log" 2>&1 &
	build_pid=$!
fi

# internal/api shard count for the fast and affected lanes: min(4, cores) unless
# LEVELRAIL_PREPUSH_API_SHARDS says otherwise. 1 keeps a single process.
api_pkg="github.com/GLINCKER/levelrail/internal/api"
api_shards="${LEVELRAIL_PREPUSH_API_SHARDS:-}"
if ! [ "$api_shards" -ge 1 ] 2>/dev/null; then
	ncpu="$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)"
	api_shards=4
	[ "$ncpu" -lt "$api_shards" ] && api_shards="$ncpu"
fi

# Bounds the internal/api run and the whole-tree run: go test's default is 10m,
# which internal/api exceeds when run whole.
go_test_timeout="${LEVELRAIL_PUSH_TEST_TIMEOUT:-30m}"

if [ "$fail" -eq 0 ] && [ "$scope" = "NONE" ]; then
	echo "pre-push: go test skipped, no Go-affecting changes vs $base_ref"
elif [ "$fail" -eq 0 ] && [ "$push_scope" = "fast" ]; then
	# Fast lane (default): test only the packages this branch edited, never
	# their dependents, and skip test/e2e. internal/api is the slowest
	# package by far (minutes), so it runs only the tests declared in test
	# files this branch touched. The compile check above already caught any
	# dependent that no longer builds; dependents' behavior and the coverage
	# gate are CI's job (ci.yml) and nightly.yml's. Set
	# LEVELRAIL_PUSH_SCOPE=affected to get the old dependents-included run.
	changed_files="$(git diff --name-only $base_ref...HEAD -- '*.go' 2>/dev/null)"
	fast_pkgs=""
	for d in $(printf '%s\n' "$changed_files" | xargs -n1 dirname 2>/dev/null | sort -u); do
		case "$d" in test/e2e* | internal/api | kit | kit/* | integrations/terraform-provider | integrations/terraform-provider/* | tools | tools/*) continue ;; esac
		if ls "$d"/*_test.go >/dev/null 2>&1; then
			fast_pkgs="$fast_pkgs ./$d"
		fi
	done
	if [ -n "$fast_pkgs" ]; then
		echo "pre-push: go test -short (fast lane):$fast_pkgs"
		# Background so the internal/api shards below overlap with it.
		pkg_log="$(mktemp -t levelrail-push-pkgs.XXXXXX)"
		# shellcheck disable=SC2086
		slot_run gotest go test $fast_pkgs -short -timeout "$go_test_timeout" >"$pkg_log" 2>&1 &
		pkg_pid=$!
	fi
	api_tests="$(printf '%s\n' "$changed_files" | grep '^internal/api/.*_test\.go$' | while read -r f; do grep -ho '^func Test[A-Za-z0-9_]*' "$f" 2>/dev/null | sed 's/^func //'; done | sort -u | paste -sd'|' -)"
	# internal/api wasn't itself touched, but it's in the affected set
	# (a dependency changed): scripts/affected-api-tests.sh (same closure
	# CI's ci-go-plan.sh uses) can sometimes narrow to the handful of
	# tests that actually reach it, instead of skipping internal/api here
	# entirely and leaving it to CI.
	if [ -z "$api_tests" ] && ! printf '%s\n' "$changed_files" | grep -q '^internal/api/' \
		&& printf '%s\n' "$scope" | grep -qxF github.com/GLINCKER/levelrail/internal/api; then
		seed_dirs="$(printf '%s\n' "$changed_files" | scripts/affected-go-packages.sh --stdin --seeds 2>/dev/null || true)"
		if [ -n "$seed_dirs" ]; then
			# Plain read loops: this hook runs under macOS's bash 3.2, which has no mapfile.
			seed_dirs_arr=()
			while IFS= read -r line; do [ -n "$line" ] && seed_dirs_arr+=("$line"); done <<<"$seed_dirs"
			seed_pkgs=()
			while IFS= read -r line; do [ -n "$line" ] && seed_pkgs+=("$line"); done < <(go list -e -f '{{.ImportPath}}' "${seed_dirs_arr[@]}" 2>/dev/null | grep -vxF "github.com/GLINCKER/levelrail/internal/api" || true)
			if [ "${#seed_pkgs[@]}" -gt 0 ]; then
				narrowed="$(scripts/affected-api-tests.sh "${seed_pkgs[@]}" 2>/dev/null || echo ALL)"
				[ "$narrowed" != ALL ] && api_tests="$narrowed"
			fi
		fi
	fi
	if [ "$fail" -eq 0 ] && [ -n "$api_tests" ]; then
		echo "pre-push: go test -short ./internal/api, only tests from changed test files"
		if ! TEST_FAST_TIMEOUT="$go_test_timeout" scripts/test-fast.sh -n "$api_shards" -r "^($api_tests)\$" 2>&1; then
			fail=1
		fi
	fi
	if [ -n "$pkg_pid" ]; then
		wait "$pkg_pid" || fail=1
		cat "$pkg_log"
		rm -f "$pkg_log"
	fi
	echo "pre-push: fast lane skips dependents, test/e2e and the coverage gate (CI runs them)"
elif [ "$fail" -eq 0 ]; then
	# -short skips the tests marked testing.Short() (flaky under load,
	# covered by nightly.yml instead).
	if [ "$scope" = "ALL" ]; then
		echo "pre-push: go test ./... -short (with coverage)"
		test_targets="./..."
	else
		pkg_count="$(printf '%s\n' "$scope" | wc -l | tr -d ' ')"
		echo "pre-push: go test -short (with coverage), scoped to $pkg_count affected package(s)"
		test_targets="$scope"
	fi
	# internal/api is sharded through scripts/test-fast.sh (CI's split) unless
	# coverage is on or shards is 1; both need one go test process.
	shard_api=0
	if [ "$api_shards" -gt 1 ] && [ "$cov_on" != on ]; then
		if [ "$scope" = "ALL" ]; then
			shard_api=1
			test_targets="$(go list ./... | grep -vxF "$api_pkg")"
		elif printf '%s\n' "$scope" | grep -qxF "$api_pkg"; then
			shard_api=1
			test_targets="$(printf '%s\n' "$scope" | grep -vxF "$api_pkg" || true)"
		fi
	fi
	# shellcheck disable=SC2086 # test_targets is intentionally word-split: either "./..." or a newline-joined package list
	cov_args=""
	[ "$cov_on" = on ] && cov_args="-coverprofile=$coverage_out"
	# shellcheck disable=SC2086 # cov_args is empty or one flag
	if [ -n "$test_targets" ] && ! go test $test_targets -short -timeout "$go_test_timeout" $cov_args 2>&1; then
		fail=1
	fi
	if [ "$shard_api" -eq 1 ]; then
		echo "pre-push: go test -short ./internal/api in $api_shards shards"
		if ! TEST_FAST_TIMEOUT="$go_test_timeout" scripts/test-fast.sh -n "$api_shards" 2>&1; then
			fail=1
		fi
	fi
fi

if [ -n "$build_pid" ]; then
	if ! wait "$build_pid"; then
		cat "$build_log"
		fail=1
	fi
fi

# tsc -b moved here from pre-commit: one type check per push, not per commit.
# Runs whenever the pushed range touches web/ (a missing base falls back to
# checking, never skipping).
if [ "$fail" -eq 0 ]; then
	if git rev-parse --verify --quiet "$base_ref" >/dev/null; then
		web_changed="$(git diff --name-only "$base_ref...HEAD" -- web/ 2>/dev/null)"
	else
		web_changed="web/"
	fi
	if [ -n "$web_changed" ]; then
		echo "pre-push: web tsc -b"
		if [ ! -x web/node_modules/.bin/tsc ]; then
			echo "web/node_modules missing, run npm ci in web/"
			fail=1
		elif ! scripts/ensure-route-tree.sh; then
			fail=1
		elif ! ( cd web && slot_run tsc env NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=${LEVELRAIL_HOOK_NODE_HEAP_MB:-8192}}" node_modules/.bin/tsc -b ) 2>&1; then
			fail=1
		fi
	fi
fi

if [ "$cov_on" = on ] && [ "$fail" -eq 0 ] && [ -f "$coverage_out" ] && [ -s "$coverage_out" ]; then
	if [ "$scope" = "ALL" ] || [ "$scope" = "NONE" ]; then
		echo "pre-push: coverage gate (internal/, 70% aggregate)"
		if ! scripts/check-coverage.sh "$coverage_out" internal/ 70; then
			fail=1
		fi
	else
		# A partial coverage profile (only the affected packages ran)
		# makes the aggregate gate meaningless, so this uses the same
		# changed-line gate CI's own coverage-gate job runs on PRs
		# instead, keeping local and CI semantics identical.
		echo "pre-push: coverage gate (changed lines under internal/, 50%)"
		if ! scripts/check-changed-file-coverage.sh "$coverage_out" $base_ref internal/ 50; then
			fail=1
		fi
	fi
fi

# kit/ is a nested module: `go test ./...` above never reaches it. It is small,
# so run the whole module whenever the branch touched it.
if [ "$fail" -eq 0 ] && git rev-parse --verify --quiet $base_ref >/dev/null \
	&& [ -n "$(git diff --name-only $base_ref...HEAD -- kit/ 2>/dev/null)" ]; then
	kit_cov="$(mktemp -t levelrail-kit-coverage.XXXXXX)"
	echo "pre-push: go test -short (kit)"
	if ! go -C kit test -short -coverprofile="$kit_cov" ./... 2>&1; then
		fail=1
	elif [ "$cov_on" = on ] && ! scripts/check-coverage.sh "$kit_cov" kit/ 70; then
		fail=1
	elif [ "$cov_on" = on ] && ! scripts/check-changed-file-coverage.sh "$kit_cov" $base_ref kit/ 50; then
		fail=1
	fi
	rm -f "$kit_cov"
fi

# Web tests related to the changed files: vitest's related mode runs every test
# that imports them, which catches a sibling test the change broke. A
# name-filtered run cannot, and CI's Web job was the first to see it.
if [ "$web_tests_on" = on ] && [ "$fail" -eq 0 ] && git rev-parse --verify --quiet $base_ref >/dev/null && [ -d web/node_modules ]; then
	web_files="$(git diff --name-only --diff-filter=ACMR $base_ref...HEAD -- 'web/src/*.ts' 'web/src/*.tsx' 2>/dev/null | sed 's#^web/##' | grep -v 'routeTree.gen')"
	if [ -n "$web_files" ]; then
		echo "pre-push: vitest related (changed web files)"
		# shellcheck disable=SC2086 # web_files is a newline-joined list of repo paths, word-splitting is intended
		if ! (cd web && slot_run vitest node_modules/.bin/vitest related --run $web_files 2>&1); then
			fail=1
		fi
	fi
fi

if [ "$fail" -ne 0 ]; then
	echo ""
	echo "pre-push checks failed, push aborted."
	exit 1
fi

echo "pre-push: all checks passed"

# Informational only, best-effort: CI stays the actual required gate.
if [ "${LEVELRAIL_PUSH_PR_SIGNAL:-on}" = on ] && command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
	branch="$(git rev-parse --abbrev-ref HEAD)"
	if [ "$branch" != main ]; then
		pr_number="$(gh pr view --json number -q .number 2>/dev/null || true)"
		if [ -n "$pr_number" ]; then
			sha="$(git rev-parse --short HEAD)"
			marker="<!-- levelrail:local-checks -->"
			body="$(printf '%s\n**Local pre-push checks passed** at `%s`\n\n<details><summary>What ran</summary>\n\n```\n%s\n```\n\n</details>\n' "$marker" "$sha" "$(tail -n 60 "$push_log")")"
			existing_id="$(gh api "repos/{owner}/{repo}/issues/$pr_number/comments" --paginate --jq ".[] | select(.body | startswith(\"$marker\")) | .id" 2>/dev/null | tail -n1 || true)"
			if [ -n "$existing_id" ]; then
				gh api -X PATCH "repos/{owner}/{repo}/issues/comments/$existing_id" -f body="$body" >/dev/null 2>&1 || true
			else
				gh pr comment "$pr_number" --body "$body" >/dev/null 2>&1 || true
			fi
			# Drafts are a WIP signal: comment only, never auto-arm merge.
			is_draft="$(gh pr view "$pr_number" --json isDraft -q .isDraft 2>/dev/null || echo true)"
			if [ "$is_draft" != true ]; then
				armed="$(gh pr view "$pr_number" --json autoMergeRequest -q '.autoMergeRequest.enabledAt // empty' 2>/dev/null || true)"
				if [ -z "$armed" ]; then
					gh pr merge "$pr_number" --auto --squash >/dev/null 2>&1 || true
				fi
			fi
		fi
	fi
fi
