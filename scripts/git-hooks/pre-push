#!/bin/bash
# The heavier gate pre-commit skips: a real test run plus the coverage
# threshold, once per push rather than once per commit.
#
# Scoped to scripts/affected-go-packages.sh's affected set rather than
# always testing ./... : a push that only touched, say,
# internal/vault/cli-docs no longer pays for internal/api's own
# multi-minute suite. Falls back to the full ./... run whenever the
# affected-set script says "ALL" or can't be trusted (no jq, detached
# HEAD with no upstream, etc.): never silently narrows scope on a tool
# that isn't actually available.
#
# No -race here, matching CI's own PR-lane precedent (ci.yml's
# Go test lanes all skip -race deliberately, calling out
# internal/api as "the slowest package by far" even without it): race
# detection can turn that same package into tens of minutes locally.
# nightly.yml's full, no-short, -race sweep is the actual safety net
# for what both this hook and CI's fast lane skip.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

fail=0
coverage_out="$(mktemp -t levelrail-coverage.XXXXXX)"
trap 'rm -f "$coverage_out"' EXIT

echo "pre-push: migration version collisions"
if ! scripts/check-migration-versions.sh; then
	fail=1
fi

echo "pre-push: go build"
if ! go build ./... 2>&1; then
	fail=1
fi

scope="ALL"
if [ "$fail" -eq 0 ] && command -v jq >/dev/null 2>&1; then
	# Best-effort: a fetch failure (offline, no network) just means the
	# affected-set is computed against whatever origin/main is already
	# known locally, which only risks over-selecting, never under.
	git fetch origin main --quiet 2>/dev/null || true
	if git rev-parse --verify --quiet origin/main >/dev/null; then
		affected_out="$(scripts/affected-go-packages.sh origin/main 2>/dev/null || echo ALL)"
		if [ -z "$affected_out" ]; then
			scope="NONE"
		elif [ "$affected_out" != "ALL" ]; then
			scope="$affected_out"
		fi
	fi
fi

if [ "$fail" -eq 0 ] && [ "$scope" = "NONE" ]; then
	echo "pre-push: go test skipped, no Go-affecting changes vs origin/main"
elif [ "$fail" -eq 0 ]; then
	# -short skips the tests marked testing.Short() (flaky under load,
	# covered by nightly.yml instead).
	if [ "$scope" = "ALL" ]; then
		echo "pre-push: go test ./... -short (with coverage)"
		test_targets="./..."
	else
		pkg_count="$(printf '%s\n' "$scope" | wc -l | tr -d ' ')"
		echo "pre-push: go test -short (with coverage), scoped to $pkg_count affected package(s)"
		test_targets="$scope"
	fi
	# shellcheck disable=SC2086 # test_targets is intentionally word-split: either "./..." or a newline-joined package list
	if ! go test $test_targets -short -coverprofile="$coverage_out" 2>&1; then
		fail=1
	fi
fi

if [ "$fail" -eq 0 ] && [ -f "$coverage_out" ] && [ -s "$coverage_out" ]; then
	if [ "$scope" = "ALL" ] || [ "$scope" = "NONE" ]; then
		echo "pre-push: coverage gate (internal/, 70% aggregate)"
		if ! scripts/check-coverage.sh "$coverage_out" internal/ 70; then
			fail=1
		fi
	else
		# A partial coverage profile (only the affected packages ran)
		# makes the aggregate gate meaningless, so this uses the same
		# changed-line gate CI's own coverage-gate job runs on PRs
		# instead, keeping local and CI semantics identical.
		echo "pre-push: coverage gate (changed lines under internal/, 70%)"
		if ! scripts/check-changed-file-coverage.sh "$coverage_out" origin/main internal/ 70; then
			fail=1
		fi
	fi
fi

if [ "$fail" -ne 0 ]; then
	echo ""
	echo "pre-push checks failed, push aborted."
	exit 1
fi

echo "pre-push: all checks passed"
