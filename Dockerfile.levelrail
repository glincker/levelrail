# syntax=docker/dockerfile:1
ARG VERSION=dev

FROM node:22-alpine AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY web/ ./
RUN npm run build

FROM golang:1.26-alpine AS build
ARG VERSION
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /src/web/dist ./web/dist
RUN CGO_ENABLED=0 go build -tags embedweb \
    -ldflags "-X github.com/GLINCKER/levelrail/internal/version.Version=${VERSION}" \
    -o /levelrail ./cmd/levelrail

FROM gcr.io/distroless/static-debian12@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2
# Root, not the :nonroot variant: this control plane needs to read/write
# /var/run/docker.sock, whose host-side group ownership varies per
# install and can't be matched to a fixed non-root uid at build time.
# distroless static has no CA bundle by default; the control plane makes
# outbound HTTPS calls (git provider APIs, ACME, S3-compatible backup
# targets) that need one.
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /levelrail /levelrail
# brand.yaml is read from disk at startup (internal/brand.Load), not
# embedded like web/dist: the default relative path "./brand.yaml"
# resolves against this image's root working directory.
COPY --from=build /src/brand.yaml /brand.yaml
EXPOSE 8080
ENTRYPOINT ["/levelrail"]
